# Copy to `.env` and fill in what you need:
#   cp .env.example .env
#
# Nothing below is required to run the demo: with ENABLE_MOCK_ENGINE=1 the mock
# engine answers every "AI" call. Add real keys one at a time to go live.

# ── Database (required) ──────────────────────────────────────────────────────
# Local embedded Postgres: `node scripts/db.mjs up` (data in ./pgdata).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/citegap
# Optional: unpooled URL used by migrations when DATABASE_URL is a pooler.
# DIRECT_URL=

# ── App (required) ───────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Signs the demo session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# ── Engines (all optional) ───────────────────────────────────────────────────
# A key turns that engine live; a missing key falls back to the mock engine.
ENABLE_MOCK_ENGINE=1

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Perplexity — https://www.perplexity.ai/settings/api (paid credit; live web search)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Google Gemini — https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Jobs (optional) ──────────────────────────────────────────────────────────
# Empty = in-process job dispatch (docs/decisions.md D11). Set only for real Inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV_SERVER=1

# ── Postgres tuning (optional) ───────────────────────────────────────────────
# Auto-detected for Supabase/Neon poolers.
# PG_PREPARE=0
# PG_POOL_MAX=5

# ── Not implemented in this build (leave empty) ──────────────────────────────
# Billing, email, abuse protection and error reporting are display-only (D13).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SENTRY_DSN=
