# Copy to `.env` and fill in what you need:
#   cp .env.example .env
#
# Nothing below is required to run the demo: with ENABLE_MOCK_ENGINE=1 the mock
# engine answers every "AI" call. Add real keys one at a time to go live.

# ── Database (required) ──────────────────────────────────────────────────────
# Local embedded Postgres: `node scripts/db.mjs up` (data in ./pgdata).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/citegap
# Optional: unpooled URL used by migrations when DATABASE_URL is a pooler.
# DIRECT_URL=

# ── App (required) ───────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Signs the demo session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32

# ── Engines (all optional) ───────────────────────────────────────────────────
# Only Gemini has a free text tier. OpenAI, Anthropic and Perplexity are paid.
# For a free, real run: GEMINI_API_KEY + a free search key (below) and
# ENABLE_MOCK_ENGINE=0. A missing key falls back to the mock engine while mock
# mode is on; with mock mode off, that engine is skipped.
ENABLE_MOCK_ENGINE=1

# PAID — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PAID — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PAID — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# FREE TIER — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Free web search (needed for real citations) ──────────────────────────────
# Google Search grounding is paid-tier only on the Gemini API. A free search key
# lets Gemini answer from real results and cite them. Tried in this order:
# Tavily → Brave → Serper; a failing provider is skipped in favour of the next.
# Tavily: 1,000 credits/month, no card — https://app.tavily.com
TAVILY_API_KEY=
# Brave: 2,000 queries/month — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Serper: 2,500 free credits — https://serper.dev
SERPER_API_KEY=

# ── Jobs (optional) ──────────────────────────────────────────────────────────
# Empty = in-process job dispatch (docs/decisions.md D11). Set only for real Inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local Inngest dev server: `npm run inngest:dev` in a second terminal.
# Cloud keys alone cannot reach localhost; use a tunnel or a deployed URL.
# INNGEST_DEV=1

# ── Postgres tuning (optional) ───────────────────────────────────────────────
# Auto-detected for Supabase/Neon poolers.
# PG_PREPARE=0
# PG_POOL_MAX=5

# ── Not implemented in this build (leave empty) ──────────────────────────────
# Billing, email, abuse protection and error reporting are display-only (D13).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SENTRY_DSN=
